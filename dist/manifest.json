{
  "manifest_version": 3,
  "name": "Synta — Transaction Safety",
  "description": "Intercepts Ethereum transactions and shows clear warnings before signing.",
  "version": "0.3.0",
  "icons": {
    "16": "icons/synta-icon-16.svg",
    "48": "icons/synta-icon-48.svg",
    "128": "icons/synta-icon-128.svg"
  },
  "action": {
    "default_popup": "index.html",
    "default_title": "Synta: Transaction Safety"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["assets/contentScript.js"],
      "run_at": "document_start"
    }
  ],
  "background": {
    "service_worker": "assets/background.js"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "notifications"
  ],
  "host_permissions": [
    "https://*/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'"
  },
  "web_accessible_resources": [
    {
      "resources": ["icons/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
